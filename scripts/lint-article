#!/usr/bin/env python3
"""Zero-token mechanical lint for a draft article (Story 5.1 / SPEC-article-review CAP-1).

This is pass 1 of the fixed review order (lint → structure → prose → cold read).
It runs BEFORE any model and spends NO LLM tokens — every check is a deterministic
string/parse/filesystem operation. It reports each defect with `path:line` so the
owner fixes the cheap-to-detect problems before a single reviewer runs.

Checks (all against the config `article` schema, never a hardcoded site schema):

  1. frontmatter — parses and conforms: every field in `frontmatter.schema` is
     present, `mode`/`language` are within their config enums, `summary` <= 240.
  2. title       — <= 70 chars (language-independent) AND carries a claim verb (a
     bare noun phrase warns). The claim-verb test is DECLARATION DATA keyed by
     language in `language-conventions.yaml` (#701); a language declaring none is
     skipped and the skip is disclosed on stderr as a `[note]`, never reported as
     a defect — the English-only heuristic had been firing on every JA title.
  3. pointer     — the owner's `owner.site_url` (from config) appears in the draft;
     the framework's mandatory pointer block is what carries it.
  4. headings    — no gap wider than ~250 words between headings.
  5. links       — relative link targets resolve on disk; `--check-http` also
     verifies http(s) links (off by default so the lint stays hermetic/offline).
  6. markers     — no `[VERIFY]` marker remains (draft-pipeline stage-4 exit gate,
     re-checked here so an unverified claim can never reach review).
  7. template    — no framework-template residue remains in the body (issue #121):
     `{slot}` placeholders, `*(prompt)*` guidance, `[SKIP: …]` / `(~N words)`
     slot annotations, or the renderer's `NOT PUBLISHABLE` marker. Per
     frameworks/CONVENTIONS.md a slot is unfilled while it still shows this
     text, and an unfilled GATE slot is not publishable — checked mechanically
     here because self-review is unreliable on this defect class. Fenced code
     blocks and inline code spans are exempt.
  8. trailer     — a `canonical-sha256` trailer must attest the content it sits
     on (#695): the trailer is the pipeline's attestation of what it last
     blessed, so a hash disagreeing with its own content is reported as a stale
     attestation. Never auto-fixed here, and never schema-class — the completion
     gate must not be blocked by it. Files carrying no trailer are out of scope.

Config source: `--config-json FILE` (or `-` for stdin), else `resolve-user-config.py`
resolves it exactly as every other skill does (machine-global + repo-local override).

Exit status: 0 when a draft is clean, 1 when any draft has a defect (or 2 on a
usage/config error) — so it drops straight into a shell gate.

Stdlib-only by design (host repos guarantee no venv / no PyYAML): the YAML-subset
parser is reused from the sibling `resolve-user-config.py`.
"""

import argparse
import hashlib
import importlib.util
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
TITLE_MAX = 70
SUMMARY_MAX = 240           # `article` schema limit (config/user-config.example.yaml)
HEADING_WORD_GAP = 250      # review-prompts.md: no gap > ~250 words between headings

# Claim-verb heuristic (review-prompts.md: "warn if title is a bare noun phrase").
# The test is DECLARATION DATA, keyed by language, in `language-conventions.yaml`
# beside `register` and `terminology` (#701): `words` are whole tokens that count
# as a claim verb, `suffixes` are token endings that do. It lived here as an
# English set until it reported every Japanese title — including one carrying the
# verb 言わせる — as a bare noun phrase. A language declaring NO test is SKIPPED
# and the skip is disclosed: a check that cannot judge a whole artifact class must
# say nothing about it rather than train the owner to ignore the lint.
CONVENTIONS_FILE = "language-conventions.yaml"


# --------------------------------------------------------------------------
# YAML-subset parser reuse (sibling resolve-user-config.py, hyphenated filename)
# --------------------------------------------------------------------------
def _load_yaml_parser():
    spec = importlib.util.spec_from_file_location(
        "_ruc", os.path.join(HERE, "resolve-user-config.py")
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.load_yaml


load_yaml = _load_yaml_parser()


# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------
def load_config(args):
    if args.config_json:
        raw = sys.stdin.read() if args.config_json == "-" else open(
            args.config_json, encoding="utf-8"
        ).read()
        return json.loads(raw)
    cmd = [sys.executable, os.path.join(HERE, "resolve-user-config.py")]
    for flag, val in (("--root", args.root), ("--global-config", args.global_config),
                      ("--repo-config", args.repo_config)):
        if val:
            cmd += [flag, val]
    cmd.append("resolved")
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit("error: could not resolve user-config:\n" + r.stderr.strip())
    return json.loads(r.stdout)


# --------------------------------------------------------------------------
# Draft parsing
# --------------------------------------------------------------------------
def split_frontmatter(text):
    """Return (frontmatter_text, fm_dict_or_None, body_start_line, error).

    body_start_line is 1-indexed (the first body line after the closing `---`).
    """
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None, None, 1, "no frontmatter block (file must open with `---`)"
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            fm_text = "\n".join(lines[1:i])
            try:
                fm = load_yaml(fm_text)
            except Exception as exc:  # YamlSubsetError and friends
                return fm_text, None, i + 2, f"frontmatter does not parse: {exc}"
            return fm_text, fm or {}, i + 2, None
    return None, None, 1, "frontmatter block is not closed (missing terminating `---`)"


def conventions_path(root, override):
    """The language-conventions declaration, resolved the way the adaptation
    stage resolves it (`adapt-canonical.py conventions_path`): an explicit
    override, else a per-repo file under the resolved repo-config directory, else
    the shipped default in this plugin's `config/`. Same order, so lint and
    adaptation can never read different declarations for the same language."""
    if override:
        return os.path.realpath(override)
    cmd = [sys.executable, os.path.join(HERE, "resolve-paths.py"), "repo-config-dir"]
    if root:
        cmd += ["--root", root]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode == 0:
        repo_local = os.path.join(r.stdout.strip(), CONVENTIONS_FILE)
        if os.path.isfile(repo_local):
            return repo_local
    return os.path.realpath(os.path.join(HERE, "..", "config", CONVENTIONS_FILE))


def resolve_claim_verb_test(root, override, language):
    """The declared claim-verb test for `language`, or None when the language
    declares none (⇒ the check is skipped and the skip is disclosed, #701).
    Returns `(words:set, suffixes:tuple)`. An unreadable or absent declaration
    file yields None for every language — a disclosed skip, never a silent pass
    of an unjudged title."""
    if not language:
        return None
    path = conventions_path(root, override)
    if not os.path.isfile(path):
        return None
    try:
        data = load_yaml(open(path, encoding="utf-8").read())
    except Exception:
        return None
    entry = ((data or {}).get("languages") or {}).get(language)
    if not isinstance(entry, dict):
        return None
    test = entry.get("title_claim_verb")
    if not isinstance(test, dict):
        return None
    words = {str(w).strip().lower() for w in (test.get("words") or []) if str(w).strip()}
    suffixes = tuple(str(s).strip().lower() for s in (test.get("suffixes") or [])
                     if str(s).strip())
    if not words and not suffixes:
        return None
    return words, suffixes


def has_claim_verb(title, test):
    """True when the title carries a claim verb under the DECLARED test. Token
    extraction is script-agnostic: word characters rather than `[A-Za-z]`, so a
    declaration for a non-Latin language works with this same matcher and no
    language becomes a branch here (CAP-6's rule, applied to the lint)."""
    words, suffixes = test
    for raw in re.findall(r"[^\W\d_]+(?:['-][^\W\d_]+)*", title.lower(), re.UNICODE):
        if raw in words or (suffixes and raw.endswith(suffixes)):
            return True
    return False


# --------------------------------------------------------------------------
# Checks — each appends (line, code, message) findings
# --------------------------------------------------------------------------
def check_frontmatter(fm, cfg, findings):
    fmcfg = cfg.get("frontmatter", {})
    schema = fmcfg.get("schema") or []
    enums = fmcfg.get("enums", {})
    for field in schema:
        if field not in fm or fm[field] in (None, ""):
            findings.append((1, "schema", f"missing required frontmatter field: {field}"))
    for key in ("mode", "language"):
        allowed = enums.get(key)
        if allowed and key in fm and fm[key] not in allowed:
            findings.append((1, "schema",
                             f"{key}={fm[key]!r} not in allowed {allowed}"))
    summary = fm.get("summary")
    if isinstance(summary, str) and len(summary.strip()) > SUMMARY_MAX:
        findings.append((1, "schema",
                         f"summary is {len(summary.strip())} chars (> {SUMMARY_MAX})"))


# Birth-record shape (hub decision 2026-07-16): <tool>@<version>+<commit>.
_GENERATED_BY_RE = re.compile(r"^[\w.-]+@[\w.\-+]+\+\S+$")


def check_generated_by(fm, findings):
    """Every canonical draft carries the immutable `generated_by` birth record
    (hub decision 2026-07-16). It can only legitimately be written at Stage-3
    creation, so its absence at review time is a generation defect, not a
    review fix — the lint surfaces it here (the review boundary must never
    compensate for a missing gate)."""
    val = fm.get("generated_by")
    if not isinstance(val, str) or not val.strip():
        findings.append((1, "birth-record",
                         "missing immutable generated_by birth record "
                         "(<tool>@<version>+<commit>, written at Stage-3 creation)"))
        return
    if not _GENERATED_BY_RE.match(val.strip()):
        findings.append((1, "birth-record",
                         f"generated_by={val!r} is not <tool>@<version>+<commit>"))


def check_title(fm, findings, verb_test, notes):
    title = fm.get("title")
    if not isinstance(title, str) or not title.strip():
        return  # missing title already reported by schema check
    title = title.strip()
    # Language-independent: a display bound, not a judgment about the prose.
    if len(title) > TITLE_MAX:
        findings.append((1, "title", f"title is {len(title)} chars (> {TITLE_MAX})"))
    # Language-keyed (#701). No declared test ⇒ no verdict, and the skip is
    # DISCLOSED: silence a reader can see, rather than a check that quietly
    # stopped applying.
    if verb_test is None:
        lang = fm.get("language") or "unknown"
        notes.append(f"claim-verb check skipped: language {lang!r} declares no "
                     f"`title_claim_verb` test in {CONVENTIONS_FILE} — the title's "
                     "length was checked, its claim was not")
        return
    if not has_claim_verb(title, verb_test):
        findings.append((1, "title",
                         "title is a bare noun phrase — no claim verb (state the claim)"))


def check_pointer_block(text, cfg, total_lines, findings):
    site_url = (cfg.get("owner", {}) or {}).get("site_url")
    if not site_url:
        return  # nothing to anchor on; config check is elsewhere
    if site_url not in text:
        findings.append((total_lines, "pointer",
                         f"pointer block missing: owner.site_url ({site_url}) not found"))


def check_heading_density(lines, body_start, findings):
    # Collect (line_no, is_heading) from body; measure words between headings.
    heading_re = re.compile(r"^\s{0,3}#{1,6}\s")
    span_start = body_start
    span_words = 0
    span_start_after_heading = False
    for idx in range(body_start - 1, len(lines)):
        line = lines[idx]
        lineno = idx + 1
        if heading_re.match(line):
            if span_words > HEADING_WORD_GAP:
                findings.append((span_start, "headings",
                                 f"{span_words} words with no heading (> {HEADING_WORD_GAP})"))
            span_start = lineno
            span_words = 0
            span_start_after_heading = True
        else:
            span_words += len(re.findall(r"\S+", line))
    if span_words > HEADING_WORD_GAP:
        findings.append((span_start, "headings",
                         f"{span_words} words with no heading (> {HEADING_WORD_GAP})"))
    _ = span_start_after_heading


_LINK_RE = re.compile(r"(?<!\!)\[[^\]]*\]\(([^)]+)\)")


def check_links(lines, draft_path, check_http, findings):
    draft_dir = os.path.dirname(os.path.realpath(draft_path))
    in_fence = False
    for idx, line in enumerate(lines):
        # Code carries illustrative link SYNTAX, not real links (#160): skip fenced
        # blocks and strip inline code spans before matching, exactly as
        # check_template_residue does — so `[x](ideas/<slug>.md)` in backticks or a
        # fenced example is not reported as a dead link.
        if _FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        scan = _INLINE_CODE_RE.sub("", line)
        for m in _LINK_RE.finditer(scan):
            target = m.group(1).strip()
            # Strip an optional link title:  (url "title")
            target = re.split(r"\s+", target, 1)[0]
            if not target or target.startswith("#") or target.startswith("mailto:"):
                continue
            if target.startswith("http://") or target.startswith("https://"):
                if check_http:
                    _check_http_link(target, idx + 1, findings)
                continue
            # relative / local link — resolve on disk (drop any #fragment)
            rel = target.split("#", 1)[0]
            if not rel:
                continue
            resolved = os.path.normpath(os.path.join(draft_dir, rel))
            if not os.path.exists(resolved):
                findings.append((idx + 1, "links", f"dead link: {target} (target not found)"))


def _check_http_link(url, lineno, findings):
    import urllib.request
    req = urllib.request.Request(url, method="HEAD",
                                 headers={"User-Agent": "lint-article/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            if resp.status not in (200, 301, 302):
                findings.append((lineno, "links", f"dead link: {url} (HTTP {resp.status})"))
    except Exception as exc:
        findings.append((lineno, "links", f"dead link: {url} ({exc})"))


def check_verify_markers(lines, findings):
    for idx, line in enumerate(lines):
        if "[VERIFY" in line:
            findings.append((idx + 1, "markers", "unresolved [VERIFY] marker"))


_FENCE_RE = re.compile(r"^\s{0,3}(```|~~~)")
_INLINE_CODE_RE = re.compile(r"`[^`]*`")
_TEMPLATE_RESIDUE = (
    (re.compile(r"\{[^{}\n]*\}"), "unfilled {slot} placeholder"),
    (re.compile(r"\*\([^)]*\)\*"), "template *(prompt)* text"),
    (re.compile(r"\[SKIP:\s*[^\]]+\]"), "[SKIP: …] slot annotation"),
    (re.compile(r"\(~\d+\s*words?\b[^)]*\)"), "(~N words) slot annotation"),
)


def check_template_residue(lines, body_start, findings):
    """Un-stripped framework-template placeholders (issue #121). Body only —
    frontmatter legitimately uses YAML flow-map braces — with fenced code
    blocks and inline code spans exempt, since prose about the slot syntax
    belongs in code markup."""
    in_fence = False
    for idx in range(body_start - 1, len(lines)):
        line = lines[idx]
        if _FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        stripped = _INLINE_CODE_RE.sub("", line)
        for pat, what in _TEMPLATE_RESIDUE:
            m = pat.search(stripped)
            if m:
                findings.append((idx + 1, "template",
                                 f"{what} not stripped: {m.group(0)!r}"))
        if "NOT PUBLISHABLE" in stripped:
            findings.append((idx + 1, "template",
                             "renderer NOT PUBLISHABLE marker present"))


_TRAILER_SHA_RE = re.compile(r"<!--\s*writing-assistant:\s*canonical-sha256="
                             r"([0-9a-f]{64})\s*-->")
# The same trailer-stripping regex the one canonical write path uses, so lint and
# the writer agree on what "the content" is by construction rather than by
# convention (`_EMISSION_TRAILER_RE`, scripts/draft-pipeline.py).
_TRAILER_STRIP_RE = re.compile(
    r"\n*<!--\s*writing-assistant:\s*canonical-sha256=[0-9a-f]{64}\s*-->\s*$")


def check_trailer_consistency(text, total_lines, findings):
    """The `canonical-sha256` trailer must attest the content it sits on
    (Story 18.104, #695). The trailer is the pipeline's attestation of the
    content it last blessed — never a comparison basis and never an authority
    (SPEC-article-draft-pipeline, amended 2026-07-25) — so a trailer disagreeing
    with its own content is an ACCURACY defect: reported here, and never
    auto-fixed by lint. A canonical that carries no trailer is out of scope: only
    files claiming an attestation can misstate one.

    Deliberately NOT a `schema`/`title` kind, so the completion gate's #674
    partition routes it to the disclosed-warning bucket rather than the
    hard-error one — a stale trailer must never block completion."""
    m = _TRAILER_SHA_RE.search(text)
    if not m:
        return
    claimed = m.group(1)
    body = _TRAILER_STRIP_RE.sub("", text).rstrip("\n") + "\n"
    actual = hashlib.sha256(body.encode("utf-8")).hexdigest()
    if actual != claimed:
        findings.append((total_lines, "trailer",
                         f"canonical-sha256 trailer claims {claimed[:8]}… but the "
                         f"content hashes to {actual[:8]}… — the attestation is "
                         "stale (an edit that bypassed the pipeline's write "
                         "path); it is re-stamped by the next sanctioned write, "
                         "never by lint"))


# --------------------------------------------------------------------------
# Driver
# --------------------------------------------------------------------------
def lint_file(path, cfg, check_http, root=None, conventions=None):
    findings, notes = [], []
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    lines = text.split("\n")
    fm_text, fm, body_start, err = split_frontmatter(text)
    if err:
        findings.append((1, "schema", err))
        # When the whole frontmatter block is absent/unparseable, per-field
        # checks never run — so name the full required set once, from the config
        # schema (never hardcoded), so a fresh draft learns the requirement here
        # instead of by grepping this script (#143).
        schema = (cfg.get("frontmatter", {}) or {}).get("schema") or []
        if schema:
            findings.append((1, "schema",
                             "required frontmatter fields: " + ", ".join(schema)
                             + " (config `frontmatter.schema`; see config/user-config.example.yaml)"))
    if fm is not None:
        check_frontmatter(fm, cfg, findings)
        check_generated_by(fm, findings)
        check_title(fm, findings,
                    resolve_claim_verb_test(root, conventions, fm.get("language")),
                    notes)
    check_pointer_block(text, cfg, len(lines), findings)
    check_heading_density(lines, body_start, findings)
    check_links(lines, path, check_http, findings)
    check_verify_markers(lines, findings)
    check_trailer_consistency(text, len(lines), findings)
    check_template_residue(lines, body_start, findings)
    findings.sort(key=lambda f: (f[0], f[1]))
    return findings, notes


def main(argv=None):
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    p.add_argument("drafts", nargs="+", help="draft markdown file(s) to lint")
    p.add_argument("--config-json", help="resolved config as JSON (FILE or - for stdin)")
    p.add_argument("--root")
    p.add_argument("--global-config")
    p.add_argument("--repo-config")
    p.add_argument("--conventions",
                   help="language-conventions.yaml override (tests); default "
                        "resolution matches adapt-canonical's")
    p.add_argument("--check-http", action="store_true",
                   help="also verify http(s) links resolve (network; off by default)")
    args = p.parse_args(argv)

    cfg = load_config(args)
    total = 0
    for path in args.drafts:
        if not os.path.isfile(path):
            print(f"{path}:0: [io] no such file", file=sys.stderr)
            total += 1
            continue
        findings, notes = lint_file(path, cfg, args.check_http, args.root,
                                    args.conventions)
        for lineno, code, msg in findings:
            print(f"{path}:{lineno}: [{code}] {msg}")
        # Disclosures are NOT defects: they go to stderr and never affect the
        # exit status, so a skipped check is visible without failing a clean
        # draft (#701).
        for note in notes:
            print(f"{path}: [note] {note}", file=sys.stderr)
        total += len(findings)
    if total:
        print(f"\n{total} defect(s) found.", file=sys.stderr)
        return 1
    print("lint: clean.", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
